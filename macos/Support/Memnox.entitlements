<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the hardened runtime lets the released app do, since notarizing requires that runtime and it shuts the
     microphone and Apple Events off unless they are named here. Used only by a Developer ID build. -->
<plist version="1.0">
<dict>
	<!-- The orb listens, so the microphone. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Bringing a session's terminal tab to the front and typing into it. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
