<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The voice's own Python under the hardened runtime notarizing requires. ctypes and the onnxruntime extension
     write executable memory, and an extension a package rebuilds is not ours, so both are allowed as python.org's
     own signed interpreter allows them. Used only by a Developer ID build. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
